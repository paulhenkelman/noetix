# Noetix Knowledge Backend — Environment Variable Overrides
# Copy to .env for secrets that shouldn't go in knowledge.config
# All other settings should go in knowledge.config (TOML)

# OpenAI API key (alternatively, place the key in ~/.openai)
# OPENAI_API_KEY=sk-...

# Override server host/port (normally set in knowledge.config)
# HOST=0.0.0.0
# PORT=8001

# Neo4j (if different from knowledge.config)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
