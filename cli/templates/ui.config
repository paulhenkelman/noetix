[server]
host = "0.0.0.0"
port = 8788
cors_origins = ["http://localhost:5174", "http://127.0.0.1:5174"]
upload_tmp_dir = "/tmp/noetix-upload"
actions_mode = "remote"

[backend]
url = "http://localhost:8001"
socks_proxy = ""
request_timeout_ms = 60000

[playwright]
mcp_url = "http://localhost:8931/mcp"
probe_timeout_ms = 3000
fallback_ports = [8931, 8932, 3000]
downloads_dir = "~/.cache/noetix-playwright"

[agent]
request_timeout_ms = 7200000
restart_delay_ms = 1000
max_restart_attempts = 5

[verify]
max_attempts = 2

[frontend]
# Leave api_base empty for the SPA to fetch from its serving origin (location.origin).
# Set to a specific URL only when the UI must talk to a backend on a different host.
api_base = ""
vite_port = 5174
