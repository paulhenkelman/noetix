[gateway]
host = "0.0.0.0"
port = 8788
cors_origins = ["http://localhost:5174", "http://127.0.0.1:5174"]
upload_tmp_dir = "/tmp/noetix-upload"
actions_mode = "remote"

[backend]
url = "http://10.0.0.50:8001"
socks_proxy = "socks5h://127.0.0.1:1080"
request_timeout_ms = 60000

[playwright]
mcp_url = "http://localhost:8931/mcp"
probe_timeout_ms = 3000
fallback_ports = [8931, 8932, 3000]
downloads_dir = "~/.cache/noetix-playwright"

[codex_client]
request_timeout_ms = 7200000
restart_delay_ms = 1000
max_restart_attempts = 5

[verify]
max_attempts = 2

[frontend]
api_base = "http://127.0.0.1:8788"
vite_port = 5174
