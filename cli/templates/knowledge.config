[server]
host = "0.0.0.0"
port = 8001
external_host = "0.0.0.0"

[openai]
api_key = ""
extraction_model = "gpt-5.1"
extraction_model_mini = "gpt-5-mini"
embedding_model = "text-embedding-3-large"
embedding_dimensions = 3072

[chunking]
chunk_size = 512
chunk_overlap = 50

[neo4j]
# Requires Neo4j running: docker compose -f knowledge/docker/docker-compose.neo4j.yml up -d
enabled = true
uri = "bolt://localhost:7687"
user = "neo4j"
password = "password"

[mcp]
port = 8002

[playwright]
mcp_url = "http://localhost:3000/sse"

[gateway]
url = "http://localhost:8788"

[storage]
knowledge_bases_dir = "knowledge_bases"
library_dir = "library"
uploads_dir = "uploads"
data_dir = "data"
